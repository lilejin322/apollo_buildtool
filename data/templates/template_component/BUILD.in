load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//tools:apollo_package.bzl", "apollo_package")
load("//tools:cpplint.bzl", "cpplint")

package(default_visibility = ["//visibility:public"])

filegroup(
  name = "{{name}}_files",
  srcs = glob([
    "dag/**",
    "launch/**",
  ]),
)

cc_binary(
  name = "lib{{ name }}_component.so",
  linkshared = True,
  linkstatic = True,
  deps = [":{{ name }}_component"],
)

cc_library(
  name = "{{ name }}_component",
  srcs = [
    "{{ name }}.cc",
  ],
  hdrs = [
    "{{ name }}.h",
  ],
  alwayslink = True,
  linkstatic = True,
  deps = [
    "//cyber",
    "{{ package_path }}/proto:{{ name }}_cc_proto",
  ]
)

apollo_package()
cpplint()